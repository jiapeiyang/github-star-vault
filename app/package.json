{
  "name": "star-vault-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "python3 ../scripts/build_catalog.py",
    "prebuild": "python3 ../scripts/build_catalog.py",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/catalog.test.mjs tests/curation.test.mjs tests/filters.test.mjs tests/routing.test.mjs tests/inbox.test.mjs tests/markdown.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "vite": "6.4.2"
  }
}
